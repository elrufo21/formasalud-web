NEXT_PUBLIC_API_URL=http://localhost:4000
# Base pública del servidor que expone /uploads/courses.
NEXT_PUBLIC_COURSE_IMAGE_BASE_URL=https://<backend-produccion>
# Backend remoto que guardará las imágenes de cursos.
COURSE_IMAGE_UPLOAD_URL=https://<backend-produccion>/upload/course-image
# Debe coincidir con el secreto configurado en el backend remoto.
COURSE_IMAGE_UPLOAD_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
